<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="green_dark">#558B2F</color>
    <color name="green_light">#AED581</color>
    <color name="green_primary">#7CB342</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">RadarCapri</string>
    <string name="notification_channel_description">Notificación permanente mientras el servicio de radares está activo</string>
    <string name="notification_channel_name">Servicio RadarCapri</string>
    <string name="notification_stop_action">Detener</string>
    <string name="notification_title">RadarCapri activo</string>
    <style name="Theme.RadarCapri" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/green_primary</item>
        <item name="android:colorPrimaryDark">@color/green_dark</item>
        <item name="android:statusBarColor">@color/green_dark</item>
    </style>
    <style name="Theme.RadarCapri.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/green_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.RadarCapri</item>
    </style>
</resources>